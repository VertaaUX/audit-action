    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
