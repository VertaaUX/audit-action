{
  "name": "@vertaaux/audit-action",
  "version": "1.0.0",
  "description": "GitHub Action for running VertaaUX audits in CI/CD workflows",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "node --import tsx/esm --test __tests__/*.test.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "github-action",
    "ux-audit",
    "accessibility",
    "usability",
    "vertaaux"
  ],
  "author": "VertaaUX",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vercel/ncc": "^0.44.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
